PROJECT_NAME="NIS Portal API"
API_V1_STR="/api/v1"
DEBUG=True

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nis_portal_db

# Asynchronous SQLAlchemy database URL (driver asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nis_portal_db
